{
  "title": "Replay Ingestion",
  "timezone": "browser",
  "panels": [
    {
      "type": "graph",
      "title": "Ingest batch latency (p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ingest_batch_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Ingest batch errors",
      "targets": [
        {
          "expr": "sum(rate(ingest_batch_errors_total[5m]))",
          "legendFormat": "errors/s"
        }
      ]
    }
  ],
  "schemaVersion": 16,
  "version": 1
}
