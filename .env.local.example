# Copy to .env.local and export before running services (or use scripts/setup-local.*)

# --- Required for control plane ---
DATABASE_URL=postgres://replay:replay@localhost:5432/replay?sslmode=disable
JWT_SECRET=local-dev-jwt-secret-change-me

# --- API gateway ---
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- Ingestion (optional; enables real batch ingest) ---
# HTTP_ADDR=:8081
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=replay-payloads
# CLICKHOUSE_URL=http://localhost:8123
# DEFAULT_ORG_ID=11111111-1111-1111-1111-111111111111

# --- Local MVP demo (serves fixture timeline/graph; auto-marks incidents ready) ---
LOCAL_DEMO_MODE=1
LOCAL_DEMO_AUTO_READY=1
LOCAL_DEMO_FIXTURES_DIR=fixtures/local
